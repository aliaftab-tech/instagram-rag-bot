# ─── Supabase (pgvector) ──────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── NVIDIA NIM API ───────────────────────────────────────────────
# Get your API key from https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx

# Models — these are the exact NVIDIA NIM models used by this project.
# Embedding model: 2048-dimensional output (native dimension, no reduction supported)
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# Reply generation LLM
NVIDIA_LLM_MODEL=nemotron-3.5-lightning-30b-a3b
# Content safety guardrail — pre-screens incoming messages before LLM reply
NVIDIA_SAFETY_MODEL=nemotron-3.5-content-safety

# ─── Instagram Graph API (Meta) ──────────────────────────────────
# Page Access Token (long-lived) from Meta Developer Dashboard
IG_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token

# Custom string you set in Meta webhook config for verification
IG_VERIFY_TOKEN=my_custom_verify_token_123

# App Secret from Meta Developer Dashboard → Settings → Basic
IG_APP_SECRET=your_app_secret_hex

# ─── Portfolio Scraping ───────────────────────────────────────────
PORTFOLIO_URL=https://aliaftab.dev

# ─── Ingest Endpoint Protection ──────────────────────────────────
# Custom secret string — pass as Authorization header when calling /api/ingest
INGEST_SECRET=my_ingest_secret_456
